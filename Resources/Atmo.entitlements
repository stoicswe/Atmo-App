<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)stoicswe.com-atmo-app</string>
	</array>
	<!-- iCloud key-value storage: PositionStore (timeline read position)
	     and BookmarkStore (bookmark sync) write to NSUbiquitousKeyValueStore;
	     without this entitlement those writes silently stay local-only. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
