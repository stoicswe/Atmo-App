<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)stoicswe.com-atmo-app</string>
	</array>
	<!-- iCloud key-value storage: PositionStore (timeline read position)
	     and BookmarkStore (bookmark sync) write to NSUbiquitousKeyValueStore;
	     without this entitlement those writes silently stay local-only. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Sensitive Content Analysis (the iMessage nudity-detection
	     framework). Analysis only runs when the user enables Sensitive
	     Content Warning in system Settings; without this entitlement the
	     analyzer reports itself disabled and the app falls back to
	     Bluesky's moderation labels alone. If automatic signing rejects
	     this, enable the "Sensitive Content Analysis" capability on the
	     stoicswe.com-atmin-app App ID in the developer portal. -->
	<!-- NOTE: this entitlement's value is an ARRAY of capability strings,
	     not a boolean — Build 21's export failed on exactly that mismatch
	     against the Xcode Cloud managed profile, which carries ("analysis"). -->
	<key>com.apple.developer.sensitivecontentanalysis.client</key>
	<array>
		<string>analysis</string>
	</array>
	<!-- Declared Age Range (Apple family controls): lets a parent share
	     the child's age bracket with the app, activating the managed
	     controls. Same portal note as above: if automatic signing rejects
	     it, enable the "Declared Age Range" capability on the App ID. -->
	<key>com.apple.developer.declared-age-range</key>
	<true/>
</dict>
</plist>
